# Copy to .env on the VPS (never commit). Compose interpolates these values.
# Paths are on the server; locally you can point *_PATH at sibling repos.

# --- Layout on the VPS ---
GAME_PATH=/opt/my-project
WISHES_PATH=/opt/wishes-app
# API_PATH=/opt/api

# --- Public sites (Caddy) ---
# Local: http://localhost
# Production: your domain, e.g. game.example.com (Caddy issues HTTPS)
GAME_SITE=http://localhost
WISHES_SITE=wishes.localhost
# API_SITE=api.example.com
CADDY_EMAIL=

# --- Game build args (same names as the game repo) ---
LC_API_BASE_URL=
LC_API_KEY=
LC_USE_API_BOOKS=false
LC_FORMSPREE_URL=
LC_RECAPTCHA_SITE_KEY=
LC_MAX_RESULTS_PER_TAG=20
LC_AUTO_TAG=true

# --- Wishes.App (mapped to AUTH0_* / APP_BASE_URL / PORT inside the container) ---
# WISHES_APP_BASE_URL: public URL, no trailing slash
WISHES_PORT=3000
WISHES_AUTH0_DOMAIN=
WISHES_AUTH0_CLIENT_ID=
WISHES_AUTH0_CLIENT_SECRET=
WISHES_AUTH0_SECRET=
WISHES_APP_BASE_URL=http://wishes.localhost
